{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "baseUrl": "./src",
    "sourceMap": true,
    "paths": {
      "~assets/*": ["assets/*"],
      "~components/*": ["components/*"],
      "~constants/*": ["constants/*"],
      "~hooks/*": ["hooks/*"],
      "~i18n/*": ["i18n/*"],
      "~layouts/*": ["layouts/*"],
      "~mocks/*": ["mocks/*"],
      "~pages/*": ["pages/*"],
      "~routes/*": ["routes/*"],
      "~types/*": ["types/*"],
      "~utils/*": ["utils/*"],
      "~store/*": ["store/*"]
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
